{
  "name": "Phone",
  "slug": "phone",
  "icon": "assets/icon.png",
  "categories": [
    "cozy"
  ],
  "version": "0.1.0",
  "licence": "AGPL-3.0",
  "editor": "Cozy",
  "source": "https://github.com/linagora/twake-phone",
  "developer": {
    "name": "Twake Workplace",
    "url": "https://twake.app"
  },
  "routes": {
    "/": {
      "folder": "/",
      "index": "index.html",
      "public": false
    },
    "/web": {
      "folder": "/",
      "index": "index.html",
      "public": false
    },
    "/web/": {
      "folder": "/",
      "index": "index.html",
      "public": false
    },
    "/intents": {
      "folder": "/intents",
      "index": "index.html",
      "public": false
    }
  },
  "permissions": {
    "banners": {
      "description": "Required by the cozy-bar to display platform messages",
      "type": "io.cozy.banners",
      "verbs": [
        "GET",
        "PUT"
      ]
    },
    "apps": {
      "description": "Required by the cozy-bar to display the icons of the apps",
      "type": "io.cozy.apps",
      "verbs": [
        "GET"
      ]
    },
    "settings": {
      "description": "Required by the cozy-bar to display Claudy and know which applications are coming soon",
      "type": "io.cozy.settings",
      "verbs": [
        "GET"
      ]
    },
    "contacts": {
      "description": "Resolve phone numbers to contacts",
      "type": "io.cozy.contacts",
      "verbs": [
        "GET"
      ]
    }
  },
  "name_prefix": "Twake",
  "intents": [
    {
      "action": "CALL",
      "type": [
        "io.twake.phone.number"
      ],
      "href": "/intents"
    },
    {
      "action": "OPEN",
      "type": [
        "io.twake.phone.widget"
      ],
      "href": "/intents"
    }
  ]
}
