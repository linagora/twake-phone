{
  "//": "The files no package tsconfig compiles (specs, test helpers, the storage contract): checked by `yarn typecheck`, and read by ESLint for its type-checked rules.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.spec.ts",
    "packages/*/src/**/*.spec.tsx",
    "packages/*/test/**/*.ts",
    "packages/phone-link/src/modules.d.ts",
    "apps/gateway/src/**/*.spec.ts",
    "apps/gateway/src/store/contract.ts"
  ]
}
