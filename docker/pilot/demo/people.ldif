# Test people of the demo profile: the same identifiers as the Keycloak realm (twakephone-realm.json), their extension
# in employeeNumber (LDAP_ATTR_EXTENSION). Loaded once, when the directory is created.
dn: ou=people,dc=twakephone,dc=demo
objectClass: organizationalUnit
ou: people

