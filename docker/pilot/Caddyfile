# The only public entry of the pilot stack, on one domain: HTTPS (port 443, port 80 for the redirect and the ACME
# challenge) in front of the services that listen on the loopback. WebSocket upgrades (Gateway events, SIP) pass as is.
{
	# The configuration is this file: no admin API on the host's loopback for a local process to rewrite.
	admin off
	# The Call-ID of a conference participant's own call (GET /conferences/:id, X-Twake-Call): it allows nothing, but
	# ties calls together and often carries an address. Caddy writes the request's headers in two logs: the access log
	# (the site's `log` below) and the error log of a request the Gateway did not answer (a 502 while it restarts), which
	# goes to this default logger. Both drop that header; Caddy already hides Authorization in both.
	log default {
		output stderr
		format filter {
			wrap json
			request>headers>X-Twake-Call delete
		}
	}
}

{$DOMAIN} {
	# An email: a Let's Encrypt certificate under that contact (DNS of DOMAIN must point here, ports 80 and 443 open).
	# "internal": a certificate from Caddy's own CA, for a test where the browsers are told to trust it.
	tls {$TLS}

	# The Gateway: REST and its event WebSocket.
	handle /api/* {
		reverse_proxy 127.0.0.1:{$GATEWAY_PORT:8080}
	}
	# SIP over WebSocket to OpenSIPS (OPENSIPS_WS_URL=wss://DOMAIN/sip): the browsers register and call through here.
	handle /sip {
		reverse_proxy 127.0.0.1:{$OPENSIPS_WS_PORT:8088}
	}
	# The demo identity provider (Keycloak, `demo` profile). Without that profile nothing listens there (502). Its
	# administration (and the master realm) and the account console, where a tester could change a password, stay
	# off the Internet: an SSH tunnel to 127.0.0.1:8180 reaches them (README).
	@keycloakPrivate path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/realms/twakephone/account /auth/realms/twakephone/account/*
	handle @keycloakPrivate {
		respond 404
	}
	handle /auth/* {
		reverse_proxy 127.0.0.1:{$KEYCLOAK_PORT:8180}
	}
	# The app itself (static files, config.json, CSP).
	handle {
		reverse_proxy 127.0.0.1:{$WEB_PORT:8081}
	}

	log {
		output stdout
		# The access log, without X-Twake-Call (see the default logger above).
		format filter {
			wrap console
			request>headers>X-Twake-Call delete
		}
	}
}
