# Copy to docker/.env (git-ignored) and fill in. Read by docker/docker-compose.dev.yml.
# Key that encrypts the per-user SIP secrets at rest (AES-256-GCM): 32 random bytes in base64.
#   openssl rand -base64 32
SECRETS_KEY=
# Shared secret between the Gateway and the PBX provisioning API.
#   openssl rand -hex 24
TWAKE_PROVISION_TOKEN=
# Credentials of the Gateway as a Meet application (see docker/README.md, "Visio").
MEET_CLIENT_ID=
MEET_CLIENT_SECRET=
# Optional: LiveKit credentials when they differ from the stack's development keys.
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=
