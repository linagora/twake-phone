# Build context: repository root. Serves the TwakePhone web app with its runtime config and security headers
# (apps/web/server): GATEWAY_URL, OIDC_AUTHORITY, OIDC_CLIENT_ID, OIDC_RESOURCE, FRAME_ANCESTORS, CONNECT_SRC, HSTS_MAX_AGE.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json yarn.lock tsconfig.base.json ./
COPY packages ./packages
COPY apps/gateway/package.json ./apps/gateway/package.json
COPY apps/web ./apps/web
# The app bundles the softphone (JsSIP) and the Gateway client: both are built before it, after the types they share.
RUN yarn install --frozen-lockfile --ignore-scripts \
    && yarn workspace @twake/telephony-types build \
    && yarn workspace @twake/telephony-client build \
    && yarn workspace @twake/softphone build \
    && yarn workspace @twake/phone-web build

FROM node:22-slim
WORKDIR /app
COPY --from=build /app/apps/web/dist ./dist
COPY apps/web/server ./server
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
USER node
CMD ["node", "server/main.mjs"]
