diff --git a/meet_app/config/livekit.yaml.template b/meet_app/config/livekit.yaml.template
index 12c72e8..59637b4 100644
--- a/meet_app/config/livekit.yaml.template
+++ b/meet_app/config/livekit.yaml.template
@@ -22,6 +22,14 @@ keys:
 
 
 
+# Participant events for the Twake Telephony Gateway (phone participants in Meet rooms).
+webhook:
+  api_key: 9f3b2c7a8e6d4f1c
+  urls:
+    - http://twake-dev-gateway:8080/api/v1/webhooks/livekit
+    # Meet itself, through its frontend proxy (which sets X-Forwarded-Proto: Meet redirects plain HTTP): room_started creates the room's dial-in rule, room_finished removes it.
+    - http://visio-frontend:8080/api/v1.0/rooms/webhooks-livekit/
+
 redis:
   address: valkey:6379
   password: valkeypass
diff --git a/meet_app/docker-compose.yml b/meet_app/docker-compose.yml
index a6d9e59..a54c0e5 100644
--- a/meet_app/docker-compose.yml
+++ b/meet_app/docker-compose.yml
@@ -47,8 +47,8 @@ services:
       DJANGO_SETTINGS_MODULE: meet.settings
       DJANGO_SILENCED_SYSTEM_CHECKS: security.W004, security.W008
       DJANGO_SECRET_KEY: ThisIsAnExampleKeyForDevPurposeOnly
-      DJANGO_ALLOWED_HOSTS: meet.${BASE_DOMAIN},visio-backend,localhost
-      ALLOWED_HOSTS: meet.${BASE_DOMAIN},visio-backend,localhost
+      DJANGO_ALLOWED_HOSTS: meet.${BASE_DOMAIN},visio-backend,localhost,visio-frontend
+      ALLOWED_HOSTS: meet.${BASE_DOMAIN},visio-backend,localhost,visio-frontend
       DJANGO_CSRF_TRUSTED_ORIGINS: https://meet.${BASE_DOMAIN}
       REDIS_URL: redis://:valkeypass@valkey:6379/1
       DJANGO_EMAIL_HOST: "mailcatcher"
@@ -71,6 +71,19 @@ services:
       LIVEKIT_API_URL: https://livekit.${BASE_DOMAIN}
       LIVEKIT_VERIFY_SSL: False
       ALLOW_UNREGISTERED_ROOMS: False
+      # Phone access (SIP dial-in) managed by Meet itself; LiveKit SIP and the trunks come from Twake Phone.
+      ROOM_TELEPHONY_ENABLED: True
+      ROOM_TELEPHONY_PHONE_NUMBER: "${MEET_TELEPHONY_NUMBER:-8000}"
+      ROOM_TELEPHONY_DEFAULT_COUNTRY: FR
+      ROOM_TELEPHONY_PIN_LENGTH: 10
+      # External API: applications (such as the Telephony Gateway) act on behalf of a user identified by email.
+      EXTERNAL_API_ENABLED: True
+      APPLICATION_JWT_SECRET_KEY: dev-application-jwt-secret-not-for-production-use
+      APPLICATION_JWT_AUDIENCE: twake-meet-external-api
+      APPLICATION_BASE_URL: https://meet.${BASE_DOMAIN}
+      APPLICATION_ALLOW_USER_CREATION: True
+      OIDC_FALLBACK_TO_EMAIL_FOR_IDENTIFICATION: True
+      OIDC_USER_SUB_FIELD_IMMUTABLE: False
       ALLOW_UNSECURE_USER_LISTING: True
       RESOURCE_DEFAULT_ACCESS_LEVEL: public
       FRONTEND_SILENCE_LIVEKIT_DEBUG: False
