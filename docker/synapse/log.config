# Synapse's log in the stack (step 11b): warnings and errors only, to the console (docker compose logs synapse): no
# line per request, none with a message's content.
version: 1
formatters:
  precise:
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
